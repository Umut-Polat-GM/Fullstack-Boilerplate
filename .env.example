# ───────────────────────── Server ─────────────────────────
NODE_ENV=development
PORT=3000
# Comma separated list of allowed origins in production (dev uses the Vite proxy)
CORS_ORIGIN=http://localhost:5173

# ──────────────────── Database (Neon PostgreSQL) ────────────────────
# Either provide a full connection string ...
DATABASE_URL=
# ... or the individual parts (used when DATABASE_URL is empty)
PGUSER=
PGPASSWORD=
PGHOST=
PGDATABASE=

# ──────────────────── Arcjet (security / rate limit) ────────────────────
# Leave empty to disable Arcjet protection locally. https://app.arcjet.com
ARCJET_KEY=
ARCJET_ENV=development
# LIVE = block, DRY_RUN = log only. Default: LIVE in production, DRY_RUN otherwise
ARCJET_MODE=

# ───────────────────────── Frontend (Vite) ─────────────────────────
# Only variables prefixed with VITE_ are exposed to the browser.
VITE_APP_NAME=Fullstack Boilerplate
# Leave empty to use the same origin (/api) — the dev server proxies it to the API.
VITE_API_URL=
