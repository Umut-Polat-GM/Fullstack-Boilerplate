{
  "name": "fullstack-boilerplate",
  "version": "2.0.0",
  "private": true,
  "description": "Modern, modular full-stack MVC boilerplate: Express 5 + Neon PostgreSQL API and React 19 + MUI + Tailwind + Zustand client.",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "npm run lint -w frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node scripts/generate-module.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "boilerplate",
    "fullstack",
    "mvc",
    "express",
    "react",
    "postgresql",
    "neon",
    "zustand",
    "mui",
    "tailwindcss"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1"
  }
}
